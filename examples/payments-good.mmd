C4Container
title Payments platform (good twin)

Person(customer, "Retail customer", "Initiates transfers")
Person(clerk, "Back-office clerk", "Fixes rejected payments")

Enterprise_Boundary(bank, "Bank") {
    System_Boundary(pay, "Payments") {
        Container(portal, "Online banking", "Java, Spring", "Customer-facing web app")
        Container(backoffice, "Back-office app", "Java, Spring", "Four-eyes repair of rejected orders")
        Container(engine, "Payment engine", "Java", "Validates and routes payments", $tags="pii")
        ContainerDb(ledger, "Payments ledger", "Oracle", "Payment orders with payer and payee data", $tags="pii;at_rest:tde")
        Container(vault, "Secrets store", "HashiCorp Vault", "Database credentials, rotated", $tags="secrets")
        Container(siem, "Security monitoring", "SIEM", "Central log collection", $tags="logging")
    }
}

System_Ext(switch, "Clearing ICT provider", "SaaS payment switch", $tags="critical;exit:secondary-switch;region:eu")
System_Ext(switch2, "Secondary clearing provider", "Standby payment switch", $tags="region:eu")

Rel(customer, portal, "Initiates payment", "HTTPS", $tags="auth:oidc")
Rel(portal, engine, "Submits payment", "HTTPS", $tags="auth:mtls")
Rel(clerk, backoffice, "Repairs rejected orders", "HTTPS", $tags="auth:oidc")
Rel(backoffice, engine, "Resubmits order", "HTTPS", $tags="auth:mtls")
Rel(engine, vault, "Fetches DB credentials", "HTTPS", $tags="auth:mtls")
Rel(engine, ledger, "Posts entries", "JDBC/TLS", $tags="auth:password")
Rel(engine, switch, "Sends payment orders", "ISO 20022 over mTLS")
Rel(engine, switch2, "Fails over payment orders", "ISO 20022 over mTLS")
Rel(engine, siem, "Ships security events", "Syslog over TLS", $tags="auth:mtls")
