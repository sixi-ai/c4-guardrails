C4Container
title RAG support chatbot (good twin)

Person(customer, "Customer", "Asks questions about their own account")
Person(agent, "Support agent", "Reviews escalated answers")

System_Boundary(chat, "Support chatbot") {
    Container(web, "Chat widget", "React SPA", "Runs in the customer's browser")
    Container(api, "Chat API", "Go", "Retrieves context and builds prompts", $tags="pii")
    ContainerDb(vec, "Vector store", "PostgreSQL + pgvector", "Embedded support tickets, pseudonymised", $tags="pii;at_rest:aes256")
    ContainerDb(crm, "Customer DB", "PostgreSQL", "Customer profiles", $tags="pii;at_rest:aes256")
    Container(review, "Human review queue", "Go", "Low-confidence answers go to a person", $tags="oversight")
    Container(kv, "Key Vault", "Azure Key Vault", "Holds the LLM API key", $tags="secrets")
    Container(logs, "Audit log", "OpenTelemetry + Log Analytics", "Prompts, retrievals and decisions", $tags="logging;records")
}

System_Ext(llm, "Hosted LLM API", "Third-party foundation model", $tags="ai;critical;region:eu-west;exit:secondary-model")

Rel(customer, web, "Chats with", "HTTPS")
Rel(web, api, "Sends messages", "HTTPS/JSON", $tags="auth:oidc")
Rel(api, vec, "Similarity search", "JDBC/TLS", $tags="auth:managed_identity")
Rel(api, crm, "Reads profile", "JDBC/TLS", $tags="auth:managed_identity")
Rel(api, kv, "Reads API key", "HTTPS", $tags="auth:managed_identity")
Rel(api, llm, "Prompt with retrieved context", "HTTPS/JSON", $tags="auth:api_key")
Rel(api, review, "Escalates low-confidence answers", "HTTPS", $tags="auth:managed_identity")
Rel(agent, review, "Approves or corrects", "HTTPS", $tags="auth:oidc")
Rel(api, logs, "Writes audit events", "OTLP/gRPC over TLS", $tags="auth:managed_identity")
